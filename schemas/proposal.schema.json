{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fast-as-50/proposal.schema.json",
  "title": "data/proposals/<id>.json — forslag til plan.json (blok 9)",
  "description": "Kontrakt jf. blok9-spec §1. set_day (blok 9), set_week_targets (ctl-recalib, 14/9-2026) set_goals og set_weight_plan (kropsmål og glidesti, 27/10-2026). Anvendes via edit_apply.apply_edit(action='apply_proposal'). additionalProperties: true.",
  "type": "object",
  "required": ["id", "title", "status", "changes"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "createdAt": {"type": ["string", "null"]},
    "createdBy": {"type": "string"},
    "title": {"type": "string"},
    "note": {"type": "string"},
    "summary": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["pending", "accepted", "rejected", "applied-offline"]},
    "decidedAt": {"type": ["string", "null"]},
    "result": {"type": ["object", "null"], "additionalProperties": true},
    "changes": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/setDay"},
          {"$ref": "#/$defs/setWeekTargets"},
          {"$ref": "#/$defs/setGoals"},
          {"$ref": "#/$defs/setWeightPlan"}
        ]
      }
    }
  },
  "$defs": {
    "setDay": {
          "type": "object",
          "required": ["date", "action", "entries"],
          "additionalProperties": true,
          "properties": {
            "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "action": {"type": "string", "enum": ["set_day"]},
            "time": {"description": "Starttid (27/9-2026) -> timeOverrides: [h, m], {disciplin: [h, m]} eller null",
                     "type": ["array", "object", "null"]},
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["workout"],
                "additionalProperties": true,
                "properties": {
                  "workout": {"type": ["object", "null"], "required": ["name", "type"], "additionalProperties": true,
                              "properties": {"name": {"type": "string"}, "type": {"type": "string"},
                                             "moving_time": {"type": "integer"}, "description": {"type": "string"}}},
                  "libraryId": {"type": "string"},
                  "templateId": {"type": "string"},
                  "note": {"type": ["string", "null"]},
                  "optional": {"type": "boolean"}
                }
              }
            }
          }
        },
    "setWeekTargets": {
      "type": "object",
      "description": "CTL-rekalibrering (14/9-2026): ugemål i et program. Ingen dato, ingen sync.",
      "required": ["action", "programId", "week"],
      "additionalProperties": true,
      "properties": {
        "action": {"type": "string", "enum": ["set_week_targets"]},
        "programId": {"type": "string"},
        "week": {"type": "integer", "minimum": 1},
        "ctlTarget": {"type": "integer", "minimum": 0},
        "tssTarget": {"type": "integer", "minimum": 0}
      }
    },
    "setGoals": {
      "type": "object",
      "description": "Kropsmål pr. program (27/10-2026). Ingen dato, ingen sync.",
      "required": ["action", "programId", "goals"],
      "additionalProperties": true,
      "properties": {
        "action": {"type": "string", "enum": ["set_goals"]},
        "programId": {"type": "string"},
        "goals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "weightKg": {"type": "number", "minimum": 40, "maximum": 150},
            "bodyFatPct": {"type": "number", "minimum": 3, "maximum": 50}
          }
        }
      }
    },
    "setWeightPlan": {
      "type": "object",
      "description": "Glidesti pr. program (27/10-2026), flettes ind i programs.<id>.weightPlan. Ingen dato, ingen sync.",
      "required": ["action", "programId", "weightPlan"],
      "additionalProperties": true,
      "properties": {
        "action": {"type": "string", "enum": ["set_weight_plan"]},
        "programId": {"type": "string"},
        "weightPlan": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "startKg": {"type": "number", "minimum": 40, "maximum": 150},
            "targetKg": {"type": "number", "minimum": 40, "maximum": 150},
            "bodyFatPctStart": {"type": "number", "minimum": 3, "maximum": 50},
            "bodyFatPctTarget": {"type": "number", "minimum": 3, "maximum": 50},
            "maxLossPerWeekKg": {"type": "number", "minimum": 0.05, "maximum": 1},
            "cutStartsFrom": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "targetDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "holdFromMonth": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
            "note": {"type": "string"}
          }
        }
      }
    }
  }
}
