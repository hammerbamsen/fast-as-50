<workout_file>
    <author>K. Hammerby / Fast as 50</author>
    <name>FaF 6 Bjerg - Sa Calobra Zwift Video</name>
    <description>Hele Sa Calobra på Zwift Video (fri kørsel, ingen ERG). Opvarm 15 min på en flad Watopia-rute, kør så videoen på 86 % FTP. Tiden på stigningen afhænger af watt og vægt — ca. 44 min på 221 W.  [IKKE ERG-MODE — du styrer selv effekten.]  PR at slå: 35:18 på 275 W (Mallorca 2023). Fuldt forsøg kun hver 4. uge og kun ved normal HRV/hvilepuls.</description>
    <sportType>bike</sportType>
    <tags><tag name="bjerg"/><tag name="sacalobra"/><tag name="video"/></tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.4500" PowerHigh="0.6800"/>
        <SteadyState Duration="2700" Power="0.8600" Cadence="72"/>
        <Cooldown Duration="600" PowerLow="0.6000" PowerHigh="0.4000"/>
    </workout>
</workout_file>
