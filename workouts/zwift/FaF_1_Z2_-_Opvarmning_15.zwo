<workout_file>
    <author>K. Hammerby / Fast as 50</author>
    <name>FaF 1 Z2 - Opvarmning 15</name>
    <description>Opvarmning før et pas på Zwift Video. Kør det i Watopia på en flad rute, afslut og start så videoen.</description>
    <sportType>bike</sportType>
    <tags><tag name="opvarmning"/></tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.4500" PowerHigh="0.6800"/>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.9500" OffPower="0.5500"/>
        <SteadyState Duration="60" Power="0.6200"/>
    </workout>
</workout_file>
