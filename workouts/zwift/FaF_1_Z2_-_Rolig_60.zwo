<workout_file>
    <author>K. Hammerby / Fast as 50</author>
    <name>FaF 1 Z2 - Rolig 60</name>
    <description>Restitutionsuger. Ren zone 2 i 60 min uden aktiveringer. Bygget 13/11-2026 til uge 47, hvor kroppen mangler restitution.  Skal føles let. Stop eller kør kortere, hvis pulsen er 10 slag højere end normalt ved samme watt.</description>
    <sportType>bike</sportType>
    <tags><tag name="z2"/><tag name="restitution"/></tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.4500" PowerHigh="0.6200"/>
        <SteadyState Duration="2400" Power="0.6400">
            <textevent timeoffset="0" message="Zone 2. Du skal kunne tale hele vejen."/>
            <textevent timeoffset="1200" message="Drik."/>
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.6200" PowerHigh="0.4000"/>
    </workout>
</workout_file>
